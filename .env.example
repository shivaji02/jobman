# jobman never stores or enters portal passwords.
# Log in once with `npm run login` — sessions persist in ~/.jobman-profile/
# (or the legacy .chrome-profile/ if you already used that).
# This file only documents runtime behavior flags.

# Set to "true" to run Puppeteer headless. Left false (default) because most
# job portals bot-detect headless Chrome and block automated sessions.
HEADLESS=false

# Optional: override the Chrome user-data profile directory
# JOBMAN_PROFILE_DIR=/custom/path/to/profile

# Optional: path to a system Chrome/Chromium binary
# PUPPETEER_EXECUTABLE_PATH=

# DO NOT put passwords here. Example of what NOT to do:
# NAUKRI_PASSWORD=...   # ❌ NEVER — use npm run login instead
# LINKEDIN_PASSWORD=... # ❌ NEVER

# --- Google discovery + direct employer applications (bots/google.js, bots/careers.js) ---
# Optional search APIs (preferred over google.com in the browser when set):
# SERPER_API_KEY=
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_ID=
# Searches per run, taken in rotation (default 7; google.com rate-limits more):
# JOBMAN_GOOGLE_MAX_QUERIES=7
# Google date filter: d | w | m (default m)
# JOBMAN_GOOGLE_RECENCY=m
# Postings older than this are rejected as stale (default 30)
# JOBMAN_MAX_POSTING_AGE_DAYS=30
# Per-run submission cap per portal (default 30)
# JOBMAN_MAX_APPS=30

# Auto-apply jobs that pass every check in src/core/auto-apply.js without
# per-job approval (others stay in the approval queue). 1 = on.
# JOBMAN_AUTO_APPLY=1
