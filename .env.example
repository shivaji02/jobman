# jobman never stores or enters portal passwords.
# Log in once with `npm run login` — sessions persist in ~/.jobman-profile/
# (or the legacy .chrome-profile/ if you already used that).
# This file only documents runtime behavior flags.

# Set to "true" to run Puppeteer headless. Left false (default) because most
# job portals bot-detect headless Chrome and block automated sessions.
HEADLESS=false

# Optional: override the Chrome user-data profile directory
# JOBMAN_PROFILE_DIR=/custom/path/to/profile

# Optional: path to a system Chrome/Chromium binary
# PUPPETEER_EXECUTABLE_PATH=

# DO NOT put passwords here. Example of what NOT to do:
# NAUKRI_PASSWORD=...   # ❌ NEVER — use npm run login instead
# LINKEDIN_PASSWORD=... # ❌ NEVER
